# Address of Arcana's own online room server (set up by the
# "Room server — set up Hetzner + Cloudflare" workflow), e.g. rooms.example.com
# Empty = the app keeps using the old Cloudflare Worker address.
ROOM_SERVER_HOSTNAME=rooms.arcanatablemtg.com
# Where the server runs: eu (Germany/Finland, cheapest) or us (Hillsboro/Ashburn).
ROOM_SERVER_REGION=eu
